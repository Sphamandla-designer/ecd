{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ECD Connect 2.0 platform tokens. Core + semantic layers are tenant-invariant; colour roles resolve via themes/<tenant>.json.",
  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": "Quicksand" },
      "body": { "$type": "fontFamily", "$value": "Inter" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typescale": {
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 600, "fontSize": "28sp", "lineHeight": "36dp" } },
    "h1": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 600, "fontSize": "24sp", "lineHeight": "32dp" } },
    "h2": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 600, "fontSize": "20sp", "lineHeight": "28dp" } },
    "h3": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 600, "fontSize": "18sp", "lineHeight": "24dp" } },
    "h4": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 600, "fontSize": "16sp", "lineHeight": "22dp" } },
    "bodyLarge": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "16sp", "lineHeight": "24dp" } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "16sp", "lineHeight": "22dp" } },
    "bodySmall": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "14sp", "lineHeight": "20dp" } },
    "bodySmallStrong": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 600, "fontSize": "14sp", "lineHeight": "20dp" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 500, "fontSize": "12sp", "lineHeight": "16dp" } },
    "button": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 600, "fontSize": "14sp", "lineHeight": "20dp" } },
    "buttonSmall": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 600, "fontSize": "12sp", "lineHeight": "16dp" } },
    "chip": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 500, "fontSize": "14sp", "lineHeight": "16dp" } },
    "chipActive": { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": 600, "fontSize": "14sp", "lineHeight": "16dp" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4dp" },
    "2": { "$type": "dimension", "$value": "8dp" },
    "3": { "$type": "dimension", "$value": "12dp" },
    "4": { "$type": "dimension", "$value": "16dp" },
    "6": { "$type": "dimension", "$value": "24dp" },
    "8": { "$type": "dimension", "$value": "32dp" },
    "screenMargin": { "$type": "dimension", "$value": "16dp" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6dp" },
    "md": { "$type": "dimension", "$value": "10dp" },
    "lg": { "$type": "dimension", "$value": "15dp" },
    "xl": { "$type": "dimension", "$value": "20dp" },
    "2xl": { "$type": "dimension", "$value": "24dp" },
    "full": { "$type": "dimension", "$value": "999dp" }
  },
  "size": {
    "touchTarget": { "$type": "dimension", "$value": "48dp" },
    "inputHeight": { "$type": "dimension", "$value": "48dp" },
    "buttonHeight": { "$type": "dimension", "$value": "40dp" },
    "buttonSmallHeight": { "$type": "dimension", "$value": "32dp" },
    "chipHeight": { "$type": "dimension", "$value": "40dp" },
    "appBarHeight": { "$type": "dimension", "$value": "64dp" },
    "avatarSm": { "$type": "dimension", "$value": "48dp" },
    "avatarLg": { "$type": "dimension", "$value": "120dp" },
    "iconDefault": { "$type": "dimension", "$value": "24dp" },
    "iconButton": { "$type": "dimension", "$value": "20dp" },
    "iconSmall": { "$type": "dimension", "$value": "16dp" },
    "iconPill": { "$type": "dimension", "$value": "14dp" },
    "progressBarHeight": { "$type": "dimension", "$value": "10dp" },
    "offlineTickerHeight": { "$type": "dimension", "$value": "24dp" }
  },
  "elevation": {
    "1": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "1dp", "blur": "2dp", "spread": "0", "color": "#0000000D" } },
    "2": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "10dp", "blur": "10dp", "spread": "-5dp", "color": "#27385A33" } },
    "3": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "10dp", "blur": "10dp", "spread": "0", "color": "#00000033" } },
    "4": { "$type": "shadow", "$value": [
      { "offsetX": "0", "offsetY": "20dp", "blur": "12.5dp", "spread": "0", "color": "#27385A1A" },
      { "offsetX": "0", "offsetY": "10dp", "blur": "5dp", "spread": "0", "color": "#27385A1A" }
    ] }
  },
  "color": {
    "$description": "Semantic status colours — platform-wide, NEVER overridden by tenant themes.",
    "neutral": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "gray50": { "$type": "color", "$value": "#F9FAFB" }
    },
    "error": {
      "main": { "$type": "color", "$value": "#ED1414" },
      "dark": { "$type": "color", "$value": "#D20000" },
      "bg": { "$type": "color", "$value": "#FFEEF6" }
    },
    "alert": {
      "main": { "$type": "color", "$value": "#FF5C00" },
      "dark": { "$type": "color", "$value": "#E43802" },
      "bg": { "$type": "color", "$value": "#FFEEE4" }
    },
    "success": {
      "main": { "$type": "color", "$value": "#83BB26" },
      "dark": { "$type": "color", "$value": "#5A8F02" },
      "bg": { "$type": "color", "$value": "#E6F1D4" }
    },
    "info": {
      "main": { "$type": "color", "$value": "#1D67D5" },
      "dark": { "$type": "color", "$value": "#1752AB" },
      "bg": { "$type": "color", "$value": "#EBF3FF" }
    }
  }
}
