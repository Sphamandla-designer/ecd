<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Neutral launch theme: no brand colour until the cached tenant theme loads,
         so a WL tenant never sees a flash of the wrong brand. -->
    <style name="Theme.EcdElp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
